{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "outputDirectory": "dist",
  "functions": { "api/plans.mjs": { "maxDuration": 120 } },
  "rewrites": [{"source":"/v1/plans","destination":"/api/plans"}],
  "headers": [
    { "source": "/(.*)", "headers": [
      {"key":"X-Content-Type-Options","value":"nosniff"},
      {"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"},
      {"key":"X-Frame-Options","value":"DENY"}
    ]},
    { "source": "/release.json", "headers": [{"key":"Cache-Control","value":"no-cache"}] }
  ]
}
